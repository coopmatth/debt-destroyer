# ---- Supabase -----------------------------------------------------------
# Safe to expose to the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS entirely — never import this into a client component
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Plaid --------------------------------------------------------------
# Environments are `sandbox` and `production`. Plaid retired `development`
# in 2024. Only depository accounts are linked — debts are entered by hand —
# so Liabilities product access is not needed.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# Public https URL Plaid posts updates to. Leave empty when self-hosting behind
# Tailscale — Plaid's servers cannot reach a .ts.net address. The daily refresh
# timer and the Sync now button cover it.
# Must exactly match an allowed redirect URI in the Plaid dashboard.
# Required for OAuth banks (Chase, BoA, Capital One, Wells Fargo...).
PLAID_REDIRECT_URI=https://your-domain.vercel.app/plaid/oauth-return
PLAID_WEBHOOK_URL=

# 32-byte key, base64 encoded, for AES-256-GCM encryption of Plaid access
# tokens at rest. Generate with: openssl rand -base64 32
PLAID_TOKEN_ENCRYPTION_KEY=

# ---- App ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
# Vercel Cron attaches this as a bearer token automatically. The scheduled
# route returns 503 rather than running unauthenticated when it is unset.
CRON_SECRET=
